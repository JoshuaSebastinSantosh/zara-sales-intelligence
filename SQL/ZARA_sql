CREATE TABLE staging_zara (
    product_id VARCHAR(30),
    product_name VARCHAR(200),
    product_category VARCHAR(50),
    product_position VARCHAR(50),
    promotion VARCHAR(10),
    seasonal VARCHAR(10),
    price_raw VARCHAR(30),
    sales_volume VARCHAR(30),
    description TEXT,
    scraped_at VARCHAR(40),
	product_type VARCHAR(40),
	gender VARCHAR(10)
);
select * from staging_zara
limit 10;

select 
	count (*) as total,
	count (product_id) as product_id_total,
	count (product_name) as product_name_total,
	count (product_category) as product_category_total,
	count (product_position) as product_position_total
from staging_zara;

select product_id, count(*) as occurrences
from staging_zara
group by product_id
having count(*) > 1;



SELECT DISTINCT product_category
FROM staging_zara
ORDER BY 1;

select distinct product_position
from staging_zara
order by 1;

select distinct product_position
from staging_zara
order by 1;





create table zara_products(
product_id varchar(10) primary key,
product_name varchar(100),
product_category varchar(50),
product_position varchar(50),
promotion boolean,
seasonal boolean,
price_raw numeric(10,2),
sales_volume int,
description text,
scraped_at timestamp,
product_type VARCHAR(40),
gender VARCHAR(10)
);
insert into zara_products
select
	trim(product_id),
	trim(product_name),
	trim(product_category),
	trim(product_position),
case
	when lower(trim(promotion)) in ('yes') then TRUE
	when lower(trim(promotion)) in ('no') then FALSE
END,
CASE
	when lower(trim(seasonal)) in ('yes') then TRUE
	when lower(trim(seasonal)) in ('no') then FALSE
END,
NULLIF(REGEXP_REPLACE(price_raw,'[^0-9.]','','g'),'')::NUMERIC,
NULLIF(REGEXP_REPLACE(sales_volume,'[^0-9.]','','g'),'')::INT,
description,
scraped_at::TIMESTAMP,
product_type,
case
	when lower(trim(gender)) in ('man') then 'M'
	when lower(trim(gender)) in ('woman') then 'w'
end
from staging_zara
where product_id is not null;
	

SELECT
    (SELECT COUNT(*) FROM staging_zara) AS staging_rows,
    (SELECT COUNT(*) FROM zara_products) AS clean_rows;

SELECT *
