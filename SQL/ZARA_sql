ALTER TABLE zara_products
ADD COLUMN price_band VARCHAR(20);

UPDATE zara_products
SET price_band =
CASE
    WHEN price_raw < 50 THEN '<50'
    WHEN price_raw < 100 THEN '50-100'
    WHEN price_raw < 150 THEN '100-150'
    WHEN price_raw < 200 THEN '150-200'
    WHEN price_raw >= 200 THEN '>200'
END;


select product_type,SUM(sales_volume) as total_sales
from zara_products
group by product_type
order by 2 desc;

select product_type, count(*) as product_count,SUM(sales_volume) as total_sales, avg(sales_volume) as avg_sales
from zara_products
group by product_type
order by 2 desc; 


select product_position, count(*) as product_count,SUM(sales_volume) as total_sales, avg(sales_volume) as avg_sales
from zara_products
group by product_position
order by avg_sales desc; 

select promotion, count(*) as product_count,SUM(sales_volume) as total_sales, avg(sales_volume) as avg_sales
from zara_products
group by promotion
order by avg_sales desc; 

select product_name ,product_type, count(*) as product_count,SUM(sales_volume) as total_sales, avg(sales_volume) as avg_sales
from zara_products
group by product_name
ORDER BY sales_volume DESC;

select product_name , product_type , sales_volume
from (select product_name , product_type,sales_volume,rank() over (partition by product_type order by sales_volume desc) as rank_in_type
from zara_products
order by product_type, rank_in_type) as rank_by_type
where rank_in_type = 1;

select product_name , product_type , sales_volume,sales_rank from
(select product_name , 
product_type , 
sales_volume, 
ROW_NUMBER() over(order by sales_volume desc) as sales_rank, 
COUNT(*) OVER () AS total_products 
from zara_products order by sales_volume desc) as ranked_products
where sales_rank<= CEIL(total_products * 0.10);

WITH ranked AS (
    SELECT sales_volume,
    ROW_NUMBER() OVER (ORDER BY sales_volume DESC) AS rn,
    COUNT(*) OVER () AS n
    FROM zara_products)
SELECT
      ROUND(SUM(sales_volume) FILTER(WHERE RN<= CEIL(N*0.1))*100/ SUM(sales_volume),1 ) AS TENPCTVOLUME
FROM ranked;


WITH RANKED AS(
	SELECT sales_volume,
	ROW_NUMBER() OVER (ORDER BY sales_volume DESC) AS RN,
	COUNT(*) OVER() AS N
	FROM zara_products)
SELECT
	ROUND(SUM(sales_volume) FILTER(WHERE RN<= ceil(N*0.1))*100 / SUM(sales_volume),1) AS  pct_volume_from_top_10pct_products
FROM RANKED;


